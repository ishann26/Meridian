# ============================================================
# Meridian AIS Stream Service — Environment Configuration
# ============================================================

# AISStream WebSocket API
AIS_API_KEY=your-aisstream-api-key
AIS_API_URL=wss://stream.aisstream.io/v0/stream

# Google Cloud Platform
GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=../agents/path/to/service-account-key.json

# Pub/Sub
PUBSUB_SHIPMENT_UPDATES_TOPIC=shipment-updates

# Firestore
FIRESTORE_COLLECTION_SHIPMENTS=live_shipments

# Reconnect settings
RECONNECT_DELAY_MS=5000
MAX_RECONNECT_ATTEMPTS=10

# Logging
LOG_LEVEL=info
