# ============================================================
# Meridian Monitoring Agent — Example Environment Config
# ============================================================
# Copy this to .env and fill in your real values.
# This file IS safe to commit to version control.
# ============================================================

GCP_PROJECT_ID=
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=

BIGQUERY_DATASET=meridian_logistics
BIGQUERY_SHIPMENTS_TABLE=planned_shipments
BIGQUERY_ROUTES_TABLE=planned_routes

FIRESTORE_COLLECTION_SHIPMENTS=live_shipments
FIRESTORE_COLLECTION_EVENTS=disruption_events

PUBSUB_SHIPMENT_UPDATES_TOPIC=shipment-updates
PUBSUB_FLIGHT_STATUS_TOPIC=flight-status-changes
PUBSUB_WEATHER_ALERTS_TOPIC=weather-alerts
PUBSUB_DISRUPTION_EVENTS_TOPIC=disruption-events
PUBSUB_SUBSCRIPTION_SHIPMENT=shipment-updates-sub
PUBSUB_SUBSCRIPTION_FLIGHT=flight-status-sub
PUBSUB_SUBSCRIPTION_WEATHER=weather-alerts-sub

SCHEDULER_SCAN_INTERVAL_MINUTES=5
SCHEDULER_JOB_NAME=monitoring-scan-job
SCHEDULER_TIMEZONE=UTC

WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5
FLIGHT_API_KEY=
FLIGHT_API_BASE_URL=https://api.aviationstack.com/v1
SHIP_TRACKING_API_KEY=
SHIP_TRACKING_API_BASE_URL=https://services.marinetraffic.com/api/exportvessel/v:8

WEIGHT_TIME_DEVIATION=0.4
WEIGHT_ROUTE_DEVIATION=0.35
WEIGHT_RISK_SCORE=0.25
DISRUPTION_THRESHOLD=65.0
ROUTE_TOLERANCE_KM=15.0
TIME_TOLERANCE_MINUTES=30.0

ML_MODEL_ENDPOINT=
ML_MODEL_API_KEY=
ML_MODEL_LOCAL_PATH=models/risk_predictor.pkl

LOG_LEVEL=INFO
ENVIRONMENT=development
PORT=8080
HOST=0.0.0.0

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
